# Gateway Data Forwarding Service Environment Variables
# Database connection parameters (same format as assistant_account)

DB_HOST=assistant-mysql
DB_PORT=3306
DB_NAME=assistant_gateway_db
DB_USER=assistant
DB_PASSWORD=123456

# Config polling interval in seconds (optional, default: 5)
GATEWAY_CONFIG_POLL_INTERVAL=5

# HTTP listen address (optional, default: :8080)
GATEWAY_HTTP_LISTEN=:8080

# MySQL credentials (for backward compatibility)
MYSQL_ROOT_PASSWORD=123456
MYSQL_USER=assistant
MYSQL_PASSWORD=123456
